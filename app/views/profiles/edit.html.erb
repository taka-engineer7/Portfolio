<div class="d-flex m-5">

  <div style="width: 300px;" class="me-5">
    <h3 class="mb-4">設定</h3>
    <div class="list-group">
      <%= link_to "アカウント", users_account_path, class: "list-group-item text-decoration-none text-black py-3" %>
      <%= link_to "プロフィール", users_profile_path, class: "list-group-item text-decoration-none text-danger py-3" %>
    </div>
  </div>

  <div class="w-100">
    <div class="d-flex justify-content-between border-bottom mb-4">
      <h3>プロフィール</h3>
      <p><%= link_to "🖊編集", users_profile_edit_path, class: "text-decoration-none fs-4" %></p>
    </div>

    <%= form_with model: @user, url: "/users/profile/edit" do |form| %>
    <div class="d-flex row align-items-center">
      <p class="col-3">アイコン画像</p>
      <p class="col-9"><%= form.file_field :avatar %></p>
    </div>
    <div class="d-flex row align-items-center">
      <p class="col-3">名前</p>
      <p class="col-9"><%= form.text_field :name, class:"form-control form-control-lg" %></p>
    </div>
    <div class="d-flex row align-items-center">
      <p class="col-3">自己紹介</p>
      <p class="col-9"><%= form.text_area :introduction, class:"form-control form-control-lg" %></p>
    </div>
    
    <div class="d-flex justify-content-end">
      <%= link_to "キャンセル", request.referer || root_path, class: "btn border p-3 me-3" %>
      <%= form.submit "保存", class: "btn text-white p-3", style: "background-color: #f77c63;" %>
    </div>
    <% end %>
  </div>

</div>