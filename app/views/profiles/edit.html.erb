<h1>プロフィール編集</h1>

<%= form_with model: @user, url: "/users/profile/edit" do |form| %>

<%= form.label :name, "名前" %>
<%= form.text_field :name %>

<%= form.label :introduction, "自己紹介" %>
<%= form.text_area :introduction %>

<%= form.label :avater, "プロフィール画像" %>
<%= form.file_field :avatar %>

<%= form.submit "保存" %>

<% end %>
