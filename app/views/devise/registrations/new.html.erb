<div class="d-flex justify-content-center bg-light">
  <div style="width: 600px;" class="m-5 p-5 bg-white">
    <h2 class="text-center">新規会員登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <p><%= f.label :name, "ニックネーム" %><span class="text-danger">*</span></p>
        <p><%= f.text_field :name, class: "form-control form-control-lg" %></p>
      </div>

      <div class="field">
        <p><%= f.label :email, "メールアドレス" %><span class="text-danger">*</span></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password, "パスワード" %><span class="text-danger">*</span></p>
        <p><%= f.password_field :password, autocomplete: "new-password", class: "form-control form-control-lg" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, "確認用パスワード" %><span class="text-danger">*</span></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg" %></p>
      </div>

      <div class="actions mb-3">
        <%= f.submit "登録する", class: "form-control form-control-lg text-white", style: "background-color: #f77c63;" %>
      </div>
    <% end %>
  
  <div class="mb-3">
    <%= button_to "ゲストログイン", guest_login_path, method: :post, class: "form-control form-control-lg text-white", style: "background-color: #495057"  %>
  </div>

  <%= render "devise/shared/links" %>
  </div>
</div>