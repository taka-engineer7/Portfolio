<div class="container-fluid p-0 home-visual">
  <%= image_tag "home_cafe.png",
    class: "w-100",
    style: "height: 610px; object-fit: cover;" %>

  <div class="home-text p-5" style="background-color: rgba(255, 255, 255, 0.6); width: 600px;">
    <h1>Find Your Perfect Workspace.</h1>
    <p>お気に入りの作業カフェを見つけよう。</p>
    <%= form_with url: cafes_path, method: :get do |f| %>
      <%= f.text_field :keyword, class: "form-control form-control-lg" %>
      <%= f.submit "検索", class: "form-control form-control-lg mt-3 text-white", style: "background-color: #f77c63;" %>
    <% end %>
  </div> 
</div>



